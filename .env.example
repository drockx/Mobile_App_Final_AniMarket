# Copy to .env.local for local development. Configure the same values in EAS for builds.
# Photon-compatible geocoder base URL. Public demo supports moderate development use.
# Use your own hosted endpoint for production volume; enable CORS for web origins.
EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io

# Messaging/authentication server. Use your PC's LAN IP for phones on the same Wi-Fi.
# If omitted in development, the app uses its Expo LAN host on port 3001.
# A release build requires your server's public HTTPS URL.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
