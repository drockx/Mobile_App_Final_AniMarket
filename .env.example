# Copy to .env.local for local development. Configure the same values in EAS for builds.
# Photon-compatible geocoder base URL. Public demo supports moderate development use.
# Use your own hosted endpoint for production volume; enable CORS for web origins.
EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io

# Messaging/authentication server. Use your PC's LAN IP for phones on the same Wi-Fi.
# If omitted in development, the app uses its Expo LAN host on port 3001.
# A release build requires your server's public HTTPS URL.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001

# Keep local until all cloud feature adapters and their access rules are tested.
# Changing this selects a backend; it never upgrades a Firebase billing plan.
EXPO_PUBLIC_BACKEND=local
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=animarket-87354.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=animarket-87354
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=144256379000

# Public provider settings. Put private server credentials only in Supabase secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
