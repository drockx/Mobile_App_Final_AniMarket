{
  "expo": {
    "name": "Mobile_App_Final_AniMarket",
    "slug": "Mobile_App_Final_AniMarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileappfinalanimarket",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android_icon_foreground.png",
        "backgroundImage": "./assets/images/android_icon_background.png",
        "monochromeImage": "./assets/images/android_icon_monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AniMarket to use your current location to choose a livestock pickup point or delivery address."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AniMarket to choose your profile photo, livestock photos, and a valid ID photo for account verification.",
          "cameraPermission": "Allow AniMarket to take your profile photo and photograph your valid ID for account verification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f7ef",
          "image": "./assets/images/branding/animarket_logo.png",
          "imageWidth": 250
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
