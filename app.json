{
  "expo": {
    "name": "AniMarket",
    "slug": "Mobile_App_Final_AniMarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/branding/animarket_logo.png",
    "scheme": "mobileappfinalanimarket",
    "userInterfaceStyle": "light",
    "ios": {
      "bitcode": false
    },
    "android": {
      "package": "com.example.animarket_final",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#eaf5ed",
        "foregroundImage": "./assets/images/branding/animarket_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/branding/animarket_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AniMarket to use your current location to choose a livestock pickup point or delivery address."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AniMarket to choose your profile photo, livestock photos, and a valid ID photo for account verification.",
          "cameraPermission": "Allow AniMarket to take your profile photo and photograph your valid ID for account verification.",
          "microphonePermission": "Allow AniMarket to use your microphone for voice calls with another user."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f7ef",
          "image": "./assets/images/branding/animarket_logo.png",
          "imageWidth": 250
        }
      ],
      "expo-secure-store",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow AniMarket to use your microphone for voice calls with another user."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68c6337e-1568-4ecc-9129-831cef15e79c"
      }
    },
    "owner": "drokcx"
  }
}
